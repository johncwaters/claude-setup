# Copy to .env and fill in. Real machine env vars still take precedence over this file.

# scratch project's phc_ capture key, used to write eval_run_completed events
EVALS_POSTHOG_PROJECT_KEY=phc_replace_with_scratch_project_capture_key

# id of the scratch PostHog project (prospective-task and mcp-regime writes land only here)
EVALS_POSTHOG_SCRATCH_PROJECT_ID=replace_with_scratch_project_id

# phx_ personal key, read-only scopes query:read + insight:read, restricted to the keeplings and scratch projects
EVALS_POSTHOG_PERSONAL_KEY=phx_replace_with_personal_key

# id of the keeplings production project the kp- tasks' reference HogQL queries run against
EVALS_POSTHOG_KEEPLINGS_PROJECT_ID=replace_with_keeplings_project_id
