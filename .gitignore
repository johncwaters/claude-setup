# Ignore everything by default; whitelist only portable config.
*
!*/

# Whitelisted config
!.gitignore
!.gitattributes
!README.md
!NOTICE.md
!CLAUDE.md
!AGENTS.md
!settings.json
!agents/**
!docs/**
!hud/**
!commands/**
!hooks/**
!skills/**
!setup/**
!compiled-commit/**
!evals/**

# Never sync these even if a rule above matches
.credentials.json
settings.local.json
evals/.env
*.bak*
*.backup*
*.tmp.*
__pycache__/
*.py[cod]

# Runtime/state dirs (blocked by * already, listed for clarity)
/projects/
/plugins/
/sessions/
/tasks/
/teams/
/cache/
/backups/
/file-history/
shell-snapshots/
session-env/
paste-cache/
debug/
downloads/
ide/
daemon/
plans/
.omc/
